<?page title="Main Content" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="template.zul"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window apply="pendaftaran.controller.PendaftaranController" border="none" width="100%" height="100%" self="@define(content)">
        <vlayout width="100%" spacing="10px" style="padding:10px">
        <listbox model="@load(vm.students)">
            <template name="model">
                <listitem>
                    <listcell label="@load(each.name)"/>
                    <listcell label="@load(each.jurusan)"/>
                    <listcell label="@load(each.address)"/>
                    <listcell>
                        <button label="Edit" onClick="@command('editStudent', student=each)"/>
                        <button label="Hapus" onClick="@command('deleteStudent', student=each)"/>
                    </listcell>
                </listitem>
            </template>
        </listbox>
        <groupbox mold="3d" width="100%">
            <caption label="Form Pendaftaran"/>
            <grid>
                <rows>
                    <row>
                        <label value="Nama:"/>
                        <textbox id="nameBox" width="250px"/>
                    </row>
                    <row>
                        <label value="Jurusan:"/>
                        <textbox id="jurusanBox" width="250px"/>
                    </row>
                    <row>
                        <label value="Alamat:"/>
                        <textbox id="addressBox" width="250px"/>
                    </row>
                    <row>
                        <cell colspan="2">
                            <button id="saveBtn" label="Simpan" style="background:#FF0090;" />
                        </cell>
                    </row>
                </rows>
            </grid>
        </groupbox>

    </vlayout>
    </window>
</zk>
