<?page title="Student Management System" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <window id="splash"
            width="100%" height="100%"
            border="none" mode="overlapped"
            style="background:#FFFFFF; position:absolute; top:0; left:0; z-index:2000;">

        <!-- CSS animation (inline for simplicity) -->
        <style>
            .rotate {
            animation: spin 2s linear infinite;
            }

            @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
            }
        </style>

        <!-- Konten splash -->
        <vlayout width="100%" height="100%"
                 style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <image src="img/image.png" width="150px" sclass="rotate" />
            <label value="Loading Aplikasi..." style="font-size:18px; margin-top:10px;" />
        </vlayout>

        <timer id="splashTimer" delay="2000" repeats="false"
               onTimer="splash.setVisible(false); splashTimer.stop();" />
    </window>



    <borderlayout width="100%" height="100%">

            <!-- Header -->
            <north size="60px" border="normal" style="background:#FBAED2;padding:10px">
                <hbox width="100%" style="display: flex; justify-content: space-between; align-items: center;">
                    <image src="/img/logo2.png" width="50px" style="margin-right:10px;margin-top:-15px" />
                    <label value="Sistem Manajemen Mahasiswa" style="font-size:18px; font-weight:bold; line-height:0px" />
                    <button label="Logout"
                            style="position:absolute; top:15px; right:20px; background:#FF0090;"
                            href="/logout" /><!-- Logout Button aligned to the right with pink background -->
                </hbox>

            </north>

            <!-- Sidebar -->
            <west size="180px" border="normal" collapsible="true" title="Menu">
                <vlayout>
                    <button label="Beranda" style="background:#FF0090;" />
                    <button label="Pendaftaran" style="background:#FF0090;" />
                    <button label="Data Mahasiswa" style="background:#FF0090;" />
                </vlayout>
            </west>

            <!-- Main Content -->
            <center border="normal" title="Data Mahasiswa" style="overflow:auto; height:100%">
                    <div self="@insert(content)" style="height:100%; overflow:auto;" />
            </center>

        </borderlayout>

</zk>
